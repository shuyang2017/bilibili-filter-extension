{
  "manifest_version": 3,
  "name": "B站本地过滤",
  "version": "0.1.0",
  "description": "本机使用的 B站过滤扩展：标记感兴趣/不感兴趣，按 UP主/分区/关键词/创作推广屏蔽。数据只存本机，不回传 B站。",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "B站本地过滤"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["src/store.js", "src/detector.js", "src/apply.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
